<script>

/* ================================================= */
/* PAGE SWITCHING */
/* ================================================= */

function hideAllPages(){

    document.querySelectorAll(".page, .gift-page")
    .forEach(page => {
        page.classList.remove("active");
    });

}

function openMainPage(){

    hideAllPages();

    document.getElementById("page2")
    .classList.add("active");

    stopAllMusic();

    /* Start main music after user interaction */
    const music = document.getElementById("introMusic");

    if(music){
        music.play().catch(()=>{});
    }
}


/* ================================================= */
/* GIFTS */
/* ================================================= */

function openGift(number){

    hideAllPages();

    const page = document.getElementById("gift" + number + "Page");

    if(page){
        page.classList.add("active");
    }

    stopAllMusic();

    if(number === 1){

        const music = document.getElementById("gift1Music");

        if(music){
            music.currentTime = 0;
            music.play().catch(()=>{});
        }

    }

    if(number === 2){

        const music = document.getElementById("gift2Music");

        if(music){
            music.currentTime = 0;
            music.play().catch(()=>{});
        }

    }

    if(number === 3){

        /* No music added here yet */

    }

    if(number === 4){

        createStars();

    }

}


/* ================================================= */
/* BACK TO MAIN */
/* ================================================= */

function backToMain(){

    stopAllMusic();

    hideAllPages();

    document.getElementById("page2")
    .classList.add("active");

}


/* ================================================= */
/* STOP MUSIC */
/* ================================================= */

function stopAllMusic(){

    const audios = document.querySelectorAll("audio");

    audios.forEach(audio => {

        audio.pause();
        audio.currentTime = 0;

    });

}


/* ================================================= */
/* CREATE STARS */
/* ================================================= */

function createStars(){

    const container =
        document.getElementById("stars");

    container.innerHTML = "";

    for(let i = 0; i < 100; i++){

        const star =
            document.createElement("div");

        star.className = "star";

        star.style.left =
            Math.random() * 100 + "%";

        star.style.top =
            Math.random() * 100 + "%";

        star.style.animationDelay =
            Math.random() * 2 + "s";

        container.appendChild(star);

    }

}


/* ================================================= */
/* MAKE MY WISH */
/* ================================================= */

function makeWish(){

    const button =
        document.querySelector(".make-wish");

    const message =
        document.getElementById("finalMessage");

    button.style.display = "none";

    /* Star burst */

    for(let i = 0; i < 80; i++){

        const burst =
            document.createElement("div");

        burst.className = "burst";

        burst.style.left = "50%";
        burst.style.top = "50%";

        const angle =
            Math.random() * Math.PI * 2;

        const distance =
            100 + Math.random() * 350;

        burst.style.setProperty(
            "--x",
            Math.cos(angle) * distance + "px"
        );

        burst.style.setProperty(
            "--y",
            Math.sin(angle) * distance + "px"
        );

        document.getElementById("gift4Page")
        .appendChild(burst);

        setTimeout(() => {
            burst.remove();
        }, 1600);

    }

    setTimeout(() => {

        message.style.display = "block";

    }, 900);

}

</script>

</body>
