<!-- ================================================= -->
<!-- GIFT 4 : MAKE A WISH -->
<!-- ================================================= -->

<section id="gift4Page" class="gift-page">

    <button class="back-btn" onclick="backToMain()">← Back</button>

    <div class="stars" id="stars"></div>

    <div class="wish-content">

