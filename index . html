    <!-- CHANGE SONG -->
    <audio id="gift1Music" loop>
        <source src="gift1-song.mp3" type="audio/mpeg">
    </audio>

</section>


<!-- ================================================= -->
<!-- GIFT 2 : CAKE -->
<!-- ================================================= -->

<section id="gift2Page" class="gift-page">

    <button class="back-btn" onclick="backToMain()">← Back</button>

    <div class="cake">
        🎂
    </div>

    <div class="cake-title">
        Happy Birthday<br>
        Miss Susmita ji 💫💫
    </div>

    <!-- CHANGE SONG -->
    <audio id="gift2Music" loop>
        <source src="gift2-song.mp3" type="audio/mpeg">
    </audio>

</section>


