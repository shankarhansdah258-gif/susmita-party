<!-- GIFT 3 : 13 WISHES -->
<!-- ================================================= -->

<section id="gift3Page" class="gift-page">

    <button class="back-btn" onclick="backToMain()">← Back</button>

    <!-- CHANGE THIS TO YOUR WISHES BACKGROUND PHOTO -->
    <img src="wishes-photo.jpg"
